# ─────────────────────────────────────────────
# VelocCMS — Configuração do ambiente
# Copie este arquivo para .env e ajuste os valores
# ─────────────────────────────────────────────

# Porta do servidor
PORT=3000

# URL pública do site (sem barra final)
# Ex: https://seusite.com.br
PUBLIC_URL=http://localhost:3000

# Caminho do banco de dados SQLite (relativo à raiz do projeto)
DB_PATH=./data/veloccms.db

# Diretório de uploads
UPLOADS_DIR=./uploads

# ── Segurança ──
# Secret do JWT (gere com: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))")
JWT_SECRET=CHANGE_ME_JWT_SECRET
JWT_EXPIRES_IN=7d

# ── Inteligência Artificial ──
# Chave da OpenAI (ou provedor compatível)
# Opcional: o CMS funciona sem IA; artigos podem ser criados manualmente
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_IMAGE_MODEL=dall-e-3